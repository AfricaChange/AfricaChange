# .env.example - variables à remplir (NE PAS COMMITER de vraies clés)
SECRET_KEY=change_me
FLASK_ENV=production
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname?sslmode=require

# Maintenance
MAINTENANCE_MODE=0
MAINTENANCE_MESSAGE="Nous effectuons une maintenance. Revenez plus tard."

# Orange Money
ORANGE_ENV=sandbox
ORANGE_CLIENT_ID=your_orange_client_id
ORANGE_CLIENT_SECRET=your_orange_client_secret
ORANGE_SANDBOX_BASE_URL=https://api.orange-money.example/sandbox
ORANGE_CALLBACK_URL=https://your-domain.example/callbacks/orange
OM_CLIENT_ID=your_orange_client_id_alias
OM_CLIENT_SECRET=your_orange_client_secret_alias
ORANGE_MERCHANT_KEY=your_orange_merchant_key
OM_MERCHANT_KEY=your_orange_merchant_key_alias
OM_CURRENCY=XOF
OM_API_KEY=your_orange_api_key

# Wave
WAVE_API_KEY=your_wave_api_key
WAVE_API_URL=https://api.wave.com/v1/transfer

# MTN
MTN_API_KEY=
MTN_USER_ID=
MTN_PRIMARY_KEY=
MTN_ENVIRONMENT=sandbox

# PayDunya
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Mail
MAILJET_API_KEY=your_mailjet_key
MAILJET_SECRET_KEY=your_mailjet_secret

# SenePay
SENEPAY_MODE=sandbox
SENEPAY_BASE_URL=https://api.senepay.example/sandbox
SENEPAY_PUBLIC_KEY=your_senepay_public_key
SENEPAY_SECRET_KEY=your_senepay_secret_key
SENEPAY_WEBHOOK_SECRET=your_senepay_webhook_secret
